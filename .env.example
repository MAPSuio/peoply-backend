DATABASE_URL=postgresql://user:pass@localhost:5432/db?schema=public

# Only needed against a managed database whose certificate is signed by a
# private CA (DigitalOcean's is). Leave it unset locally — the dev database
# runs without TLS. The value is the CA certificate itself, PEM and all:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----"

# Must be byte-identical to the `issuer` the provider publishes in its
# discovery document, trailing slash and all — openid-client v6 compares the
# two and refuses to start on a mismatch. Vipps publishes it with the slash.
VIPPS_OIDC_ISSUER=https://apitest.vipps.no/access-management-1.0/access/
VIPPS_OIDC_LOGIN_CLIENT_ID=your-vipps-client-id
VIPPS_OIDC_LOGIN_CLIENT_SECRET=your-vipps-client-secret
VIPPS_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback
VIPPS_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
VIPPS_OIDC_LOGIN_SCOPE="openid address email birthDate name phoneNumber"

GOOGLE_OIDC_ISSUER=https://accounts.google.com/
GOOGLE_OIDC_LOGIN_CLIENT_ID=your-google-client-id
GOOGLE_OIDC_LOGIN_CLIENT_SECRET=your-google-client-secret
GOOGLE_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback/google
GOOGLE_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
GOOGLE_OIDC_LOGIN_SCOPE="openid profile email"

# The secrets below must each be a different random value. The app refuses to
# start if the access and refresh secrets match, because that makes a 30-day
# refresh token usable as an access token. Generate one per line with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-session
JWT_ACCESS_TOKEN_SECRET=change-me-access
# access token / cookie lifetime in seconds (12 hours)
JWT_ACCESS_TOKEN_EXP_TIME=43200
JWT_REFRESH_TOKEN_SECRET=change-me-refresh
# refresh token / cookie lifetime in seconds (30 days)
JWT_REFRESH_TOKEN_EXP_TIME=2592000
JWT_VERIFICATION_TOKEN_SECRET=change-me-verification
JWT_VERIFICATION_TOKEN_EXP_TIME=86400
LOCAL_AUTH_ENABLED=false
CORS_ORIGIN="http://localhost:3001"
# Set to ".peoply.app" in production so the frontend can read the session
# marker cookie. Leave unset locally, where both apps are on localhost.
# SESSION_COOKIE_DOMAIN=".peoply.app"
FRONTEND_URL="http://localhost:3001"

# Comma-separated list of emails granted access to the /moderation endpoints
# (the stats page in the frontend). Unset means nobody has access and /stats
# shows no data.
# MODERATOR_EMAILS=you@example.com,other@example.com

AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_COMMUNICATION_CONNECTION_STRING=your-azure-communication-connection-string
LOCATION_SEARCH_PROVIDER=entur
ENTUR_GEOCODER_CLIENT_NAME=your-company-your-app
MCP_KEY_PEPPER=change-me
