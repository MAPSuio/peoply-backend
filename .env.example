DATABASE_URL=postgresql://user:pass@localhost:5432/db?schema=public

VIPPS_OIDC_ISSUER=https://apitest.vipps.no/access-management-1.0/access
VIPPS_OIDC_LOGIN_CLIENT_ID=your-vipps-client-id
VIPPS_OIDC_LOGIN_CLIENT_SECRET=your-vipps-client-secret
VIPPS_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback
VIPPS_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
VIPPS_OIDC_LOGIN_SCOPE="openid address email birthDate name phoneNumber"

GOOGLE_OIDC_ISSUER=https://accounts.google.com/
GOOGLE_OIDC_LOGIN_CLIENT_ID=your-google-client-id
GOOGLE_OIDC_LOGIN_CLIENT_SECRET=your-google-client-secret
GOOGLE_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback/google
GOOGLE_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
GOOGLE_OIDC_LOGIN_SCOPE="openid profile email"

SESSION_SECRET=change-me
JWT_ACCESS_TOKEN_SECRET=change-me
# access token / cookie lifetime in seconds (12 hours)
JWT_ACCESS_TOKEN_EXP_TIME=43200
JWT_REFRESH_TOKEN_SECRET=change-me
# refresh token / cookie lifetime in seconds (30 days)
JWT_REFRESH_TOKEN_EXP_TIME=2592000
JWT_VERIFICATION_TOKEN_SECRET=change-me
JWT_VERIFICATION_TOKEN_EXP_TIME=86400
LOCAL_AUTH_ENABLED=false
CORS_ORIGIN="http://localhost:3001"
FRONTEND_URL="http://localhost:3001"

AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_MAPS_KEY=your-azure-maps-key
AZURE_COMMUNICATION_CONNECTION_STRING=your-azure-communication-connection-string
