# Environment for CI jobs that boot the application.
#
# The Joi schema in `app.module.ts` rejects a missing variable at startup, so
# anything the app validates has to be present here even when the test does not
# touch that integration. Every value is a placeholder — no credential in this
# file reaches a real service, and nothing here is a secret.
#
# Loaded with `.github/actions/load-ci-env`. Jobs that only read the source
# (lint) or only compile it (build) do not need it.

SESSION_SECRET=test-session-secret
JWT_ACCESS_TOKEN_SECRET=test-access-token-secret
JWT_ACCESS_TOKEN_EXP_TIME=3600
JWT_REFRESH_TOKEN_SECRET=test-refresh-token-secret
JWT_REFRESH_TOKEN_EXP_TIME=86400
JWT_VERIFICATION_TOKEN_SECRET=test-verification-token-secret
JWT_VERIFICATION_TOKEN_EXP_TIME=86400

CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# The app fetches the issuer's OIDC discovery document at startup, so this has
# to be a real, reachable issuer. The client credentials beside it do not.
#
# This pointed at accounts.google.com, which booted CI fine and made it blind
# to everything Vipps-specific. Three defects shipped to production behind that
# blind spot in one day, all from the same openid-client v5 -> v6 bump: Vipps
# publishes its issuer with a trailing slash and v6 compares identifiers
# exactly, so the app crashed on boot; v6 omits `state` for a provider that
# advertises PKCE and Vipps requires it, so every login bounced off a Vipps
# error page; and v6 defaults to client_secret_post where Vipps wants Basic, so
# the token exchange answered invalid_client. CI was green for all three
# because CI was talking to Google.
#
# Vipps' test environment publishes the same discovery document shape as
# production and needs no credentials to read, so pointing at it costs nothing
# and puts the real provider in the boot path.
VIPPS_OIDC_ISSUER=https://apitest.vipps.no/access-management-1.0/access/
VIPPS_OIDC_LOGIN_CLIENT_ID=test-vipps-client-id
VIPPS_OIDC_LOGIN_CLIENT_SECRET=test-vipps-client-secret
VIPPS_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback
VIPPS_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
VIPPS_OIDC_LOGIN_SCOPE=openid

GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_LOGIN_CLIENT_ID=test-google-client-id
GOOGLE_OIDC_LOGIN_CLIENT_SECRET=test-google-client-secret
GOOGLE_OIDC_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback/google
GOOGLE_OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3001/login/callback
GOOGLE_OIDC_LOGIN_SCOPE=openid profile email

AZURE_STORAGE_ACCOUNT=test-storage-account
AZURE_STORAGE_KEY=test-storage-key
AZURE_STORAGE_SKIP_INIT=true
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://example.communication.azure.com/;accesskey=test

LOCATION_SEARCH_PROVIDER=entur
ENTUR_GEOCODER_CLIENT_NAME=test-ci-client
MCP_KEY_PEPPER=test-mcp-key-pepper-at-least-32-chars
