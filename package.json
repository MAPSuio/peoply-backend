{
  "name": "peoply-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engineStrict": true,
  "engines": {
    "node": ">=20.11.0 < 21.0.0",
    "npm": ">=10.0.0 < 11.0.0"
  },
  "scripts": {
    "prisma:deploy": "npx prisma migrate deploy",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "npm run prisma:deploy && npm run seed:prod-db",
    "build:dev": "npm run prebuild && nest build",
    "format": "biome format --write",
    "dev": "node scripts/run-dev.js",
    "dev:raw": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node scripts/run-start.js",
    "start:dev-db": "cd dev-db && sudo make start",
    "stop:dev-db": "cd dev-db && sudo make stop",
    "restart:dev-db": "cd dev-db && sudo make restart",
    "migrate:dev-db": "npx prisma migrate dev",
    "seed:dev-db": "ts-node ./prisma/dev-seed.ts",
    "seed:prod-db": "npx prisma db seed",
    "init:dev-db": "npm run restart:dev-db && sleep 3 && npm run migrate:dev-db && sleep 3 && npm run seed:dev-db",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db": "jest --config test/jest-db-tests.json",
    "test:dev-script": "node scripts/run-dev.test.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0-beta.1",
    "@azure/storage-blob": "^12.9.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^4.5.0",
    "azure-maps-rest": "^2.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.17.3",
    "express-session": "^1.17.2",
    "helmet": "^7.2.0",
    "joi": "^18.2.1",
    "node-ical": "^0.20.1",
    "openid-client": "^5.1.5",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.5.5",
    "swagger-ui-express": "^4.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^8.0.10",
    "@nestjs/testing": "^10.4.22",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.2",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.4",
    "@types/jest": "30.0.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.0.0",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^8.3.4",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "jest-util": "^30.4.1",
    "prisma": "^4.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.2.8",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^3.14.1",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "@nestjs/mapped-types": {
      "class-validator": "^0.15.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.0"
    },
    "file-type": "20.5.0",
    "@babel/traverse": "^7.23.2",
    "@babel/helpers": "^7.26.10",
    "@sideway/formula": "^3.0.1",
    "body-parser": "^1.20.6",
    "braces": "^3.0.3",
    "cookie": "^0.7.0",
    "cookiejar": "^2.1.4",
    "fast-uri": "^3.1.4",
    "form-data": "^4.0.6",
    "formidable": "^2.1.2",
    "jose": "^4.15.9",
    "js-yaml": "^4.3.0",
    "json5": "^2.2.3",
    "jws": "^3.2.3",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.8",
    "multer": "^2.2.0",
    "on-headers": "^1.1.0",
    "qs": "^6.15.2",
    "tough-cookie": "^4.1.3",
    "word-wrap": "^1.2.5",
    "ws": "^7.5.10"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
