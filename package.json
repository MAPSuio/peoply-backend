{
  "name": "peoply-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0 < 25.0.0",
    "npm": ">=11.0.0 < 13.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "prisma:deploy": "npx prisma migrate deploy",
    "prebuild": "rimraf dist",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "npm run build && npm prune --omit=dev",
    "images:downscale": "node dist/scripts/downscale-stored-images.js",
    "organizations:backfill-colors": "node dist/scripts/backfill-organization-colors.js",
    "predeploy:prod": "npm run prisma:deploy && node dist/prisma/seed.js",
    "format": "biome format --write",
    "dev": "node scripts/run-dev.js",
    "dev:raw": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node dist/src/main.js",
    "start:dev-db": "cd dev-db && sudo make start",
    "stop:dev-db": "cd dev-db && sudo make stop",
    "restart:dev-db": "cd dev-db && sudo make restart",
    "migrate:dev-db": "npx prisma migrate dev",
    "seed:dev-db": "npm run build && node dist/prisma/dev-seed.js",
    "seed:prod-db": "npx prisma db seed",
    "init:dev-db": "npm run restart:dev-db && sleep 3 && npm run migrate:dev-db && sleep 3 && npm run seed:dev-db",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:database-tls": "jest --config test/jest-database-tls.json --runInBand",
    "test:dev-script": "node scripts/run-dev.test.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.33.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/api-reference": "^1.69.2",
    "@scalar/nestjs-api-reference": "^1.2.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "joi": "^18.2.9",
    "node-ical": "^0.27.2",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "clearMocks": true,
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs|@scalar)/)"
    ]
  },
  "overrides": {
    "@nestjs/mapped-types": {
      "class-validator": "^0.15.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^5.4.2"
    },
    "@ai-sdk/provider-utils": "^4.0.33",
    "@babel/traverse": "^8.0.6",
    "@babel/helpers": "^8.0.5",
    "axios": "^1.20.0",
    "brace-expansion": "^5.0.12",
    "cookie": "^0.7.2",
    "cookiejar": "^2.1.4",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^4.2.1",
    "find-my-way": "^9.9.0",
    "form-data": "^4.0.6",
    "formidable": "^3.5.4",
    "jose": "^6.2.12",
    "js-yaml": "^5.4.2",
    "json5": "^2.2.3",
    "jws": "^4.0.1",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "mysql2": "^3.23.1",
    "on-headers": "^1.1.0",
    "picomatch": "^4.0.7",
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "qs": "^6.16.0",
    "tough-cookie": "^6.0.2",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "valibot": "^1.5.0",
    "xml2js": "^0.6.2"
  }
}
