{
  "name": "peoply-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0 < 25.0.0",
    "npm": ">=11.0.0 < 12.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "prisma:deploy": "npx prisma migrate deploy",
    "prebuild": "rimraf dist",
    "postinstall": "prisma generate",
    "build": "nest build",
    "predeploy:prod": "npm run prisma:deploy && node dist/prisma/seed.js",
    "format": "biome format --write",
    "dev": "node scripts/run-dev.js",
    "dev:raw": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node scripts/run-start.js",
    "start:dev-db": "cd dev-db && sudo make start",
    "stop:dev-db": "cd dev-db && sudo make stop",
    "restart:dev-db": "cd dev-db && sudo make restart",
    "migrate:dev-db": "npx prisma migrate dev",
    "seed:dev-db": "ts-node ./prisma/dev-seed.ts",
    "seed:prod-db": "npx prisma db seed",
    "init:dev-db": "npm run restart:dev-db && sleep 3 && npm run migrate:dev-db && sleep 3 && npm run seed:dev-db",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db": "jest --config test/jest-db-tests.json",
    "test:database-tls": "jest --config test/jest-database-tls.json --runInBand",
    "test:dev-script": "node scripts/run-dev.test.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0-beta.1",
    "@azure/storage-blob": "^12.9.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@scalar/api-reference": "^1.63.0",
    "@scalar/nestjs-api-reference": "^1.2.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "joi": "^18.2.3",
    "node-ical": "^0.20.1",
    "openid-client": "^5.1.5",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^20.5.3",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.2",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^2.0.12",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "jest-util": "^30.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^3.14.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "@nestjs/mapped-types": {
      "class-validator": "^0.15.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.0"
    },
    "@babel/traverse": "^7.23.2",
    "@babel/helpers": "^7.26.10",
    "@sideway/formula": "^3.0.1",
    "axios": "^1.18.1",
    "brace-expansion": "^5.0.8",
    "braces": "^3.0.3",
    "cookie": "^0.7.0",
    "cookiejar": "^2.1.4",
    "fast-uri": "^3.1.4",
    "find-my-way": "^9.7.0",
    "form-data": "^4.0.6",
    "formidable": "^2.1.2",
    "jose": "^4.15.9",
    "js-yaml": "^4.3.0",
    "json5": "^2.2.3",
    "jws": "^3.2.3",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.8",
    "multer": "^2.2.0",
    "on-headers": "^1.1.0",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "word-wrap": "^1.2.5",
    "ws": "^7.5.10",
    "xml2js": "^0.6.2"
  }
}
