// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// `prisma-client` rather than `prisma-client-js`: the latter still works in
// Prisma 7 but is deprecated and slated for removal, and moving later would
// mean redoing the same import rewrite without the context for it.
//
// The client is emitted as TypeScript into `src/generated/prisma`, not into
// `node_modules`, which is why `output` is mandatory. That directory is
// git-ignored and rebuilt by the `postinstall` hook — Prisma 7 no longer
// generates on install by itself. `moduleFormat` is pinned to cjs because
// this application is CommonJS; the v7 default is ESM.
//
// `fullTextSearchPostgres` stays in preview for PostgreSQL. The `description`
// filters in EventsService and OrganizationsService use `search:`, which does
// not exist without it.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres"]
}

// Prisma 7 no longer accepts `url` here. The connection string moved to
// `prisma.config.ts`, and the client itself is handed a driver adapter — see
// `src/prisma/prisma.adapter.ts`.
datasource db {
  provider = "postgresql"
}

model Organization {
  id                      String                       @id @default(uuid())
  urlId                   String?                      @unique @map("url_id")
  arranger                Arranger                     @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  arrangerId              String                       @unique @map("arranger_id")
  name                    String
  orgNr                   String?                      @unique @map("org_nr") @db.VarChar(9)
  approved                Boolean                      @default(true)
  image                   String?
  imagePrimaryColor       String?                      @map("image_primary_color") @db.VarChar(7)
  imageAccentColor        String?                      @map("image_accent_color") @db.VarChar(7)
  description             String?                      @db.Text
  websiteUrl              String?                      @map("website_url")
  instagramUrl            String?                      @map("instagram_url")
  facebookUrl             String?                      @map("facebook_url")
  tiktokUrl               String?                      @map("tiktok_url")
  linkedinUrl             String?                      @map("linkedin_url")
  youtubeUrl              String?                      @map("youtube_url")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @default(now()) @updatedAt @map("updated_at")
  icsFeed                 OrganizationIcsFeed?
  organizationRoles       UserOrganizationRole[]
  organizationInvitations OrganizationInvitation[]
  coOrganizerInvitations  EventCoOrganizerInvitation[]
  reports                 OrganizationReport[]

  @@map("organizations")
}

model User {
  id                             String                       @id @default(uuid())
  arranger                       Arranger                     @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  arrangerId                     String                       @unique @map("arranger_id")
  phone                          String?                      @unique
  firstName                      String                       @map("first_name") @db.VarChar(100)
  lastName                       String                       @map("last_name") @db.VarChar(100)
  email                          String                       @unique
  image                          String?
  birthDate                      DateTime?                    @map("birth_date") @db.Date
  description                    String?                      @db.VarChar(120)
  foodPreference                 FoodPreference?              @map("food_preference")
  allowEmailPromotions           Boolean                      @default(false) @map("allow_email_promotions")
  allowEmailFromArranger         Boolean                      @default(true) @map("allow_email_from_arranger")
  allowEmailOnWaitlist           Boolean                      @default(true) @map("allow_email_on_waitlist")
  refreshTokenId                 String?                      @map("refresh_token_id")
  createdAt                      DateTime                     @default(now()) @map("created_at")
  updatedAt                      DateTime                     @default(now()) @updatedAt @map("updated_at")
  organizationRoles              UserOrganizationRole[]
  registrations                  Registration[]
  providerUsers                  ProviderUser[]
  favorites                      Favorite[]
  eventInvitationsToMe           EventInvitation[]            @relation("ToUserEventInvitations")
  eventInvitationsFromMe         EventInvitation[]            @relation("FromUserEventInvitations")
  origanizationInvitationsToMe   OrganizationInvitation[]     @relation("ToUserOrganizationInvitations")
  origanizationInvitationsFromMe OrganizationInvitation[]     @relation("FromUserOrganizationInvitations")
  coOrganizerInvitationsSent     EventCoOrganizerInvitation[] @relation("FromUserEventCoOrganizerInvitations")
  coOrganizerInvitationsAnswered EventCoOrganizerInvitation[] @relation("RespondedEventCoOrganizerInvitations")
  arrangerFollowers              ArrangerFollower[]
  eventUpdates                   EventUpdate[]
  feedbackEntries                Feedback[]
  organizationReports            OrganizationReport[]
  userAllergens                  UserAllergen[]
  userSeenUpdates                UserSeenUpdate[]

  @@map("users")
}

model UserSeenUpdate {
  userId    String             @map("user_id")
  update    UserSeenUpdateType
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")

  @@id([userId, update])
  @@map("user_seen_updates")
}

model Popup {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(4000)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([startsAt, endsAt])
  @@map("popups")
}

enum UserSeenUpdateType {
  HAS_SET_ALLERGENS
}

enum FoodPreference {
  NO_PREFERENCE
  PESCETARIAN
  VEGETARIAN
  VEGAN

  @@map("food_preferences")
}

model Allergen {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")
  UserAllergen UserAllergen[]

  @@map("allergens")
}

model UserAllergen {
  userId     String   @map("user_id")
  allergenId Int      @map("allergen_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, allergenId])
  @@map("user_allergens")
}

model ProviderUser {
  sub       String
  provider  Provider
  id        String
  user      User     @relation(fields: [id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([sub, provider])
  // One identity per provider per user keeps "unlink Google" unambiguous.
  // Its leading column also serves the "list this user's providers" lookup,
  // which the primary key (led by sub) cannot.
  @@unique([id, provider])
  @@map("provider_users")
}

enum Provider {
  VIPPS
  GOOGLE

  @@map("providers")
}

model UserOrganizationRole {
  organizationId  String           @map("organization_id")
  userId          String           @map("user_id")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            OrganizationRole
  roleDescription String?          @map("role_description")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  @@id([organizationId, userId])
  // The composite id only serves lookups starting at organizationId; listing
  // the organizations a user belongs to filters on userId alone.
  @@index([userId])
  @@map("user_organization_roles")
}

enum OrganizationRole {
  ADMIN
  MEMBER
  OWNER

  @@map("organization_roles")
}

model Arranger {
  id                     String                  @id @default(uuid())
  isBusiness             Boolean                 @map("is_business")
  organization           Organization?
  user                   User?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  eventArrangers         EventArranger[]
  arrangerFollowers      ArrangerFollower[]
  arrangerFollowerEvents ArrangerFollowerEvent[]

  @@map("arrangers")
}

model Event {
  id                     String                       @id @default(uuid())
  urlId                  String                       @unique @map("url_id")
  startDate              DateTime                     @map("start_date")
  endDate                DateTime?                    @map("end_date")
  regStart               DateTime?                    @map("reg_start")
  regEnd                 DateTime?                    @map("reg_end")
  title                  String                       @db.VarChar(150)
  description            String
  capacity               Int?
  visibility             EventVisibility
  hasFood                Boolean                      @default(false) @map("has_food")
  formQuestion           String?                      @map("form_question")
  featured               Boolean                      @default(false)
  image                  String?                      @unique
  locationName           String                       @map("location_name") @db.VarChar(100)
  poiName                String?                      @map("poi_name") @db.VarChar(500)
  country                String?                      @db.VarChar(500)
  countryCode            String?                      @map("country_code") @db.VarChar(500)
  countryCodeISO3        String?                      @map("country_code_iso3") @db.VarChar(500)
  countrySubdivision     String?                      @map("country_subdivision") @db.VarChar(500)
  localName              String?                      @map("local_name") @db.VarChar(500)
  municipality           String?                      @db.VarChar(500)
  postalCode             String?                      @map("postal_code") @db.VarChar(500)
  streetName             String?                      @map("street_name") @db.VarChar(500)
  streetNumber           String?                      @map("street_number") @db.VarChar(500)
  freeformAddress        String?                      @map("free_form_address") @db.VarChar(500)
  latitude               Float?
  longitude              Float?
  source                 EventSource                  @default(MANUAL)
  registrationMode       EventRegistrationMode        @default(PEOPLY) @map("registration_mode")
  externalId             String?                      @map("external_id")
  externalUrl            String?                      @map("external_url")
  externalUpdatedAt      DateTime?                    @map("external_updated_at")
  archivedAt             DateTime?                    @map("archived_at")
  readOnly               Boolean                      @default(false) @map("read_only")
  organizationIcsFeedId  String?                      @map("organization_ics_feed_id")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @default(now()) @updatedAt @map("updated_at")
  organizationIcsFeed    OrganizationIcsFeed?         @relation(fields: [organizationIcsFeedId], references: [id], onDelete: Cascade)
  eventArrangers         EventArranger[]
  registrations          Registration[]
  eventCategories        EventCategory[]
  favorites              Favorite[]
  eventInvitations       EventInvitation[]
  coOrganizerInvitations EventCoOrganizerInvitation[]
  eventUpdates           EventUpdate[]

  @@unique([organizationIcsFeedId, externalId])
  @@index([urlId])
  @@index([archivedAt])
  // `GET /events` filters on startDate and orders by it, then takes a page.
  // Without this the planner has to sort the whole table to answer a query
  // that only ever wants the next handful of rows.
  @@index([startDate])
  @@map("events")
}

model OrganizationIcsFeed {
  id                   String                @id @default(uuid())
  organizationId       String                @unique @map("organization_id")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url                  String
  registrationMode     EventRegistrationMode @default(EXTERNAL) @map("registration_mode")
  enabled              Boolean               @default(true)
  syncIntervalMinutes  Int                   @default(60) @map("sync_interval_minutes")
  lastSyncedAt         DateTime?             @map("last_synced_at")
  lastSuccessfulSyncAt DateTime?             @map("last_successful_sync_at")
  lastSyncStatus       IcsFeedSyncStatus     @default(PENDING) @map("last_sync_status")
  lastSyncError        String?               @map("last_sync_error") @db.Text
  consecutiveFailures  Int                   @default(0) @map("consecutive_failures")
  disabledAt           DateTime?             @map("disabled_at")
  syncStartedAt        DateTime?             @map("sync_started_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")
  importedEvents       Event[]

  @@map("organization_ics_feeds")
}

model OrganizationReport {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, userId, createdAt])
  @@map("organization_reports")
}

model EventUpdate {
  id              String                @id @default(uuid())
  visibility      EventUpdateVisibility
  eventId         String                @map("event_id")
  event           Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sendEmail       Boolean               @map("send_email")
  azureMessageId  String?               @map("azure_message_id")
  subject         String
  body            String
  replyTo         String?               @map("reply_to")
  createdByUserId String                @map("created_by_user_id")
  createdByUser   User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at")

  // Both foreign keys cascade and neither was indexed: reads filter on
  // eventId, and deleting a user or event had to scan this table.
  @@index([eventId])
  @@index([createdByUserId])
  @@map("event_updates")
}

enum EventUpdateVisibility {
  ALL
  GOING
  DELETED

  @@map("event_update_visibility")
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED

  @@map("event_visibility")
}

enum EventSource {
  MANUAL
  ICS

  @@map("event_sources")
}

enum EventRegistrationMode {
  PEOPLY
  EXTERNAL
  NONE

  @@map("event_registration_mode")
}

enum IcsFeedSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  DISABLED

  @@map("ics_feed_sync_status")
}

model ArrangerFollower {
  arrangerId String   @map("arranger_id")
  userId     String   @map("user_id")
  arranger   Arranger @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@id([arrangerId, userId])
  // Listing the arrangers a user follows filters on userId alone.
  @@index([userId])
  @@map("arranger_follower")
}

/* Append-only log of follow/unfollow actions, kept because unfollowing
   hard-deletes the ArrangerFollower row: net follower growth over time can
   only be computed from this log. Deliberately has no userId — analytics
   needs none, and an FK to users would let account deletion cascade FOLLOW
   rows away and corrupt the net counts. */
model ArrangerFollowerEvent {
  id         String       @id @default(uuid())
  arrangerId String       @map("arranger_id")
  arranger   Arranger     @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  action     FollowAction
  createdAt  DateTime     @default(now()) @map("created_at")

  // The only read is one arranger's events inside a time window.
  @@index([arrangerId, createdAt])
  @@map("arranger_follower_events")
}

enum FollowAction {
  FOLLOW
  UNFOLLOW

  @@map("follow_actions")
}

model EventArranger {
  eventId    String            @map("event_id")
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  arrangerId String            @map("arranger_id")
  arranger   Arranger          @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  role       EventArrangerRole
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  @@id([eventId, arrangerId])
  // Listing the events an arranger organises filters on arrangerId alone.
  @@index([arrangerId])
  @@map("event_arrangers")
}

enum EventArrangerRole {
  ADMIN
  COLLABORATOR

  @@map("event_arranger_roles")
}

model Registration {
  eventId    String    @map("event_id")
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formAnswer String?   @map("form_answer")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  regStatus  RegStatus @map("reg_status")

  @@id([eventId, userId])
  // Listing a user's registrations filters on userId alone.
  @@index([userId])
  @@map("registrations")
}

enum RegStatus {
  INVITED
  GOING
  NOT_GOING
  WAITLISTED
  BANNED

  @@map("reg_statuses")
}

model Category {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  eventCategories EventCategory[]

  @@map("categories")
}

model EventCategory {
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([categoryId, eventId])
  // Reading and replacing an event's categories filters on eventId alone,
  // which is the trailing column of the composite id.
  @@index([eventId])
  @@map("event_categories")
}

model Favorite {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([eventId, userId])
  // Listing a user's favorites filters on userId alone.
  @@index([userId])
  @@map("favorites")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("feedback")
}

model EventInvitation {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromUserId String   @map("from_user_id")
  fromUser   User     @relation(name: "FromUserEventInvitations", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String   @map("to_user_id")
  toUser     User     @relation(name: "ToUserEventInvitations", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  // This field should never be used to indicate event status
  // Invitation and registration are to very seperate things
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")

  @@unique([eventId, fromUserId, toUserId])
  // Listing a user's incoming invitations filters on toUserId, which the
  // unique constraint above cannot serve (it leads with eventId).
  @@index([toUserId])
  @@map("event_invitations")
}

model OrganizationInvitation {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUserId       String           @map("from_user_id")
  fromUser         User             @relation(name: "FromUserOrganizationInvitations", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId         String           @map("to_user_id")
  toUser           User             @relation(name: "ToUserOrganizationInvitations", fields: [toUserId], references: [id], onDelete: Cascade)
  organizationRole OrganizationRole @map("organization_role")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")

  @@unique([organizationId, organizationRole, toUserId, invitationStatus])
  // Listing a user's incoming invitations filters on toUserId, which is the
  // third column of the unique constraint above.
  @@index([toUserId])
  @@map("organization_invitations")
}

// An event admin asking an organization to co-organize. Unlike the two
// invitation models above this one is addressed to an organization rather than
// a user: the row is created once, and every ADMIN/OWNER of that organization
// sees it among their notifications until one of them answers. Accepting is
// what creates the EventArranger COLLABORATOR row — before that the event does
// not carry the invited organization's name or logo anywhere.
model EventCoOrganizerInvitation {
  id                String           @id @default(uuid())
  eventId           String           @map("event_id")
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId    String           @map("organization_id")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Nullable because co-organizers that predate this table were attached
  // directly, with nobody on record as having asked.
  fromUserId        String?          @map("from_user_id")
  fromUser          User?            @relation(name: "FromUserEventCoOrganizerInvitations", fields: [fromUserId], references: [id], onDelete: SetNull)
  // Who answered on the organization's behalf. Null while PENDING, and reset
  // to null if that user is later deleted — the answer itself still stands.
  respondedByUserId String?          @map("responded_by_user_id")
  respondedByUser   User?            @relation(name: "RespondedEventCoOrganizerInvitations", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  invitationStatus  InvitationStatus @default(PENDING) @map("invitation_status")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")

  // One invitation per organization per event: re-inviting after a decline
  // reuses the row rather than stacking up duplicate notifications.
  @@unique([eventId, organizationId])
  // The notification query filters on the organizations a user administers
  // plus the status.
  @@index([organizationId, invitationStatus])
  @@index([fromUserId])
  @@index([respondedByUserId])
  @@map("event_coorganizer_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  IGNORED

  @@map("invitation_statuses")
}
