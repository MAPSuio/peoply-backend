// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String                 @id @default(uuid())
  arranger          Arranger               @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  arrangerId        String                 @unique @map("arranger_id")
  name              String
  orgNr             String                 @unique @map("org_nr") @db.VarChar(9)
  image             String?                @db.VarChar(100)
  organizationRoles UserOrganizationRole[]

  @@map("organizations")
}

model User {
  id                String                 @id @default(uuid())
  arranger          Arranger               @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  arrangerId        String                 @unique @map("arranger_id")
  phone             String                 @unique
  firstName         String                 @map("first_name") @db.VarChar(100)
  lastName          String                 @map("last_name") @db.VarChar(100)
  email             String                 @unique
  image             String?
  birthDate         DateTime?              @map("birth_date") @db.Date
  description       String?                @db.VarChar(120)
  organizationRoles UserOrganizationRole[]
  registrations     Registration[]
  providerUsers     ProviderUser[]
  favorites         Favorite[]

  @@map("users")
}

model ProviderUser {
  sub      String
  provider Provider
  id       String
  user     User     @relation(fields: [id], references: [id], onDelete: Cascade)

  @@id([sub, provider])
  @@map("provider_users")
}

enum Provider {
  VIPPS

  @@map("providers")
}

model UserOrganizationRole {
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole

  @@id([organizationId, userId])
  @@map("user_organization_roles")
}

enum OrganizationRole {
  ADMIN

  @@map("organization_roles")
}

model Arranger {
  id             String          @id @default(uuid())
  isBusiness     Boolean         @map("is_business")
  organization   Organization?
  user           User?
  eventArrangers EventArranger[]

  @@map("arrangers")
}

model Event {
  id              String          @id @default(uuid())
  numericId       Int             @unique @default(autoincrement()) @map("numeric_id")
  startDate       DateTime        @map("start_date")
  endDate         DateTime        @map("end_date")
  title           String          @db.VarChar(150)
  description     String
  capacity        Int?
  private         Boolean         @default(false)
  image           String?         @unique
  eventArrangers  EventArranger[]
  registrations   Registration[]
  eventCategories EventCategory[]
  favorites       Favorite[]

  @@map("events")
}

model EventArranger {
  eventId    String            @map("event_id")
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  arrangerId String            @map("arranger_id")
  arranger   Arranger          @relation(fields: [arrangerId], references: [id], onDelete: Cascade)
  role       EventArrangerRole

  @@id([eventId, arrangerId])
  @@map("event_arrangers")
}

enum EventArrangerRole {
  ADMIN
  COLLABORATOR

  @@map("event_arranger_roles")
}

model Registration {
  eventId    String    @map("event_id")
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  regDate    DateTime  @default(now()) @map("reg_date")
  regStatus  RegStatus @default(INVITED) @map("reg_status")
  attendance Boolean   @default(false)

  @@id([eventId, userId])
}

enum RegStatus {
  INVITED
  GOING
  NOT_GOING
  WAITLISTED

  @@map("reg_statuses")
}

model Category {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  eventCategories EventCategory[]

  @@map("categories")
}

model EventCategory {
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)


  @@id([categoryId, eventId])
  @@map("event_categories")
}

model Favorite {
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId       String   @map("event_id")
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  favoritedDate DateTime @default(now()) @map("favorited_date")

  @@id([eventId, userId])
  @@map("favorites")
}
