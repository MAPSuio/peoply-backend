// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model organizations {
  organization_id    String                    @id @default(uuid())
  arranger           arrangers                 @relation(fields: [arranger_id], references: [arranger_id], onDelete: Cascade)
  arranger_id        String                    @unique
  name               String
  org_nr             String                    @unique @db.VarChar(9)
  image              String?                   @db.VarChar(100)
  organization_roles user_organization_roles[]
}

model users {
  user_id            String                    @id @default(uuid())
  arranger           arrangers                 @relation(fields: [arranger_id], references: [arranger_id], onDelete: Cascade)
  arranger_id        String                    @unique
  phone              String                    @unique
  first_name         String                    @db.VarChar(100)
  last_name          String?
  email              String                    @unique
  image              String?
  birth_date         DateTime?                 @db.Date
  description        String?                   @db.VarChar(120)
  organization_roles user_organization_roles[]
  registrations      registrations[]
  provider_users     provider_users[]
  favorites          favorites[]
}

model provider_users {
  provider_sub String
  provider     providers
  user_id      String
  user         users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([provider_sub, provider])
}

enum providers {
  VIPPS
}

model user_organization_roles {
  organization_id String
  user_id         String
  organization    organizations      @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  user            users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role            organization_roles

  @@id([organization_id, user_id])
}

enum organization_roles {
  ADMIN
}

model arrangers {
  arranger_id     String            @id @default(uuid())
  is_business     Boolean
  organization    organizations?
  user            users?
  event_arrangers event_arrangers[]
}

model events {
  event_id         String             @id @default(uuid())
  event_numeric_id Int                @unique @default(autoincrement())
  start_date       DateTime
  end_date         DateTime
  title            String             @db.VarChar(150)
  description      String
  capacity         Int?
  private          Boolean            @default(false)
  image            String?            @unique
  event_arrangers  event_arrangers[]
  registrations    registrations[]
  event_categories event_categories[]
  favorites        favorites[]
}

model event_arrangers {
  event_id    String
  event       events               @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  arranger_id String
  arranger    arrangers            @relation(fields: [arranger_id], references: [arranger_id], onDelete: Cascade)
  role        event_arranger_roles

  @@id([event_id, arranger_id])
}

enum event_arranger_roles {
  ADMIN
  COLLABORATOR
}

model registrations {
  event_id   String
  event      events     @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  user_id    String
  user       users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  reg_date   DateTime   @default(now())
  reg_status reg_status @default(INVITED)
  attendance Boolean    @default(false)

  @@id([event_id, user_id])
}

enum reg_status {
  INVITED
  GOING
  NOT_GOING
  WAITLISTED
}

model categories {
  category_id      Int                @id @default(autoincrement())
  category         String             @unique
  event_categories event_categories[]
}

model event_categories {
  category_id Int
  category    categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade)
  event_id    String
  event       events     @relation(fields: [event_id], references: [event_id], onDelete: Cascade)


  @@id([category_id, event_id])
}

model favorites {
  user_id  String 
  user     users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  event_id String 
  event    events @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  favorite_date   DateTime   @default(now())

  @@id([event_id, user_id])
}
